# ─── Configurações do Banco de Dados (MySQL Docker) ──────────────────────────
MYSQL_ROOT_PASSWORD=sua_senha_root
MYSQL_DATABASE=uorderflow
MYSQL_USER=uorderflow_user
MYSQL_PASSWORD=sua_senha_usuario

# ─── Configurações da Aplicação Spring Boot ─────────────────────────────────
UORDERFLOW_DB_URL=jdbc:mysql://localhost:3307/uorderflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
UORDERFLOW_DB_USER=uorderflow_user
UORDERFLOW_DB_PASS=sua_senha_usuario
UORDERFLOW_JWT_SECRET=sua_chave_secreta_jwt_de_pelo_menos_256_bits
